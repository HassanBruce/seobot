# ---------- Site ----------
SITE_URL=https://toolswhisper.io
SITE_NAME=ToolsWhisper
AUDIENCE=developers, marketers and students who need quick free online tools
# Which URLs in your sitemap are tools / blog posts
TOOL_URL_PATTERN=/tools/
BLOG_URL_PATTERN=/blog/
# BLOG_BASE_URL=https://toolswhisper.io/blog

# ---------- AI (same Gemini key) ----------
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# ---------- Google Search Console (free, see README) ----------
GSC_KEY_FILE=/app/secrets/gsc.json
GSC_SITE=sc-domain:toolswhisper.io

# ---------- Publishing: none | folder | webhook ----------
PUBLISH_MODE=none
# folder: Next.js/Astro/Hugo content folder inside the container (mount it in docker-compose.yml)
CONTENT_DIR=/site/content/blog
FILE_EXT=mdx
GIT_PUSH=false
# webhook: your Laravel route that creates a post
WEBHOOK_URL=
WEBHOOK_TOKEN=

# ---------- Rhythm ----------
POSTS_PER_WEEK=3
# keep false: you approve each post in the dashboard
AUTO_PUBLISH=false

# ---------- Telegram (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3400
ADMIN_PASSWORD=change-me
