# Gemini (free key from aistudio.google.com); first model, then fallback
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# comma separated
REPORT_TO=

REPORT_LANG=simple Roman Urdu (Urdu in English letters), technical words in English
MAX_PAGES=300
INSPECT_PER_DAY=20
